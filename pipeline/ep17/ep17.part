// ---------- ep17: dog + turkey bone — Thanksgiving dining room ----------
const HERO={skin:'#F0C29C',hair:'#7A3B22',top:'#D9682F',pants:'#3B3F5C',shoe:'#5A3A2A',hairStyle:'long'};
const FUR='#D99A5B', FURD='#B5773D', CREAM='#F7E9D2', EAR='#7A4A2A';
const HX=470, FLOOR=600, DX=730, BINX=940;   // hero x, floor (feet y), dog x, bin x
// ---------- props ----------
function boneProp(x,y,rot,s=1,meat=true){ return `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})">`+
  `<rect x="-34" y="-7" width="62" height="14" rx="6" fill="#F4EAD2" stroke="${OL}" stroke-width="3.5"/>`+
  `<circle cx="-36" cy="-8" r="9" fill="#F4EAD2" stroke="${OL}" stroke-width="3.5"/><circle cx="-36" cy="8" r="9" fill="#F4EAD2" stroke="${OL}" stroke-width="3.5"/><rect x="-36" y="-6" width="12" height="12" fill="#F4EAD2"/>`+
  (meat?`<path d="M6,-14 C30,-26 58,-18 60,0 C58,18 30,26 6,14 C12,4 12,-4 6,-14Z" fill="#A8592A" stroke="${OL}" stroke-width="3.5" stroke-linejoin="round"/><path d="M22,-10 q12,-4 22,2" stroke="#D7894F" stroke-width="4" fill="none" stroke-linecap="round"/>`:`<circle cx="32" cy="-8" r="9" fill="#F4EAD2" stroke="${OL}" stroke-width="3.5"/><circle cx="32" cy="8" r="9" fill="#F4EAD2" stroke="${OL}" stroke-width="3.5"/><rect x="22" y="-6" width="12" height="12" fill="#F4EAD2"/>`)+`</g>`; }
function shard(x,y,rot,s=1){ return `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})"><path d="M-14,-4 L10,-8 L16,0 L6,6 L-12,5Z" fill="#F4EAD2" stroke="${OL}" stroke-width="3" stroke-linejoin="round"/></g>`; }
function skinBit(x,y,rot,s=1){ return `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})"><path d="M-26,-6 Q-14,-16 0,-8 Q14,-16 26,-6 Q20,8 6,4 Q-6,12 -20,6Z" fill="#E1A04E" stroke="${OL}" stroke-width="3" stroke-linejoin="round"/><path d="M-12,-4 q6,-4 12,0" stroke="#F3C27A" stroke-width="3" fill="none"/></g>`; }
function fatBit(x,y,s=1){ return `<g transform="translate(${x},${y}) scale(${s})"><path d="M-18,4 Q-20,-12 -4,-14 Q14,-18 18,-2 Q20,12 2,12 Q-14,14 -18,4Z" fill="#FFF3C9" stroke="${OL}" stroke-width="3"/><ellipse cx="-4" cy="-4" rx="5" ry="3" fill="#fff"/></g>`; }
function plate(x,y,s=1,inner=''){ return `<g transform="translate(${x},${y}) scale(${s})"><ellipse rx="40" ry="13" fill="#F7F4EE" stroke="${OL}" stroke-width="3.5"/><ellipse rx="27" ry="8" fill="none" stroke="#D8D2C6" stroke-width="2.5"/>${inner}</g>`; }
function turkeyBird(x,y,s=1,missing=false){ let t=`<g transform="translate(${x},${y}) scale(${s})">`;
  t+=`<ellipse cx="0" cy="8" rx="96" ry="22" fill="#E9E4DA" stroke="${OL}" stroke-width="4"/><ellipse cx="0" cy="6" rx="78" ry="14" fill="none" stroke="#CFC7B8" stroke-width="3"/>`;
  t+=`<path d="M-30,6 Q-34,-40 -64,-40 Q-82,-36 -76,-18 Q-66,-6 -44,4Z" fill="#B8642E" stroke="${OL}" stroke-width="4"/><circle cx="-80" cy="-38" r="8" fill="#F4EAD2" stroke="${OL}" stroke-width="3"/>`;
  t+=`<path d="M-62,4 Q-66,-54 0,-60 Q66,-54 62,4Z" fill="#C46F33" stroke="${OL}" stroke-width="4.5"/><path d="M-36,-30 Q-10,-50 20,-44" stroke="#E79A55" stroke-width="7" fill="none" stroke-linecap="round" opacity=".8"/>`;
  if(!missing) t+=`<path d="M30,6 Q34,-40 64,-40 Q82,-36 76,-18 Q66,-6 44,4Z" fill="#B8642E" stroke="${OL}" stroke-width="4"/><circle cx="80" cy="-38" r="8" fill="#F4EAD2" stroke="${OL}" stroke-width="3"/>`;
  else t+=`<path d="M40,-4 Q52,-16 60,-6" stroke="#8A4A22" stroke-width="5" fill="none"/>`;
  t+=`<circle cx="-50" cy="10" r="7" fill="#7FB04E"/><circle cx="52" cy="12" r="7" fill="#7FB04E"/><circle cx="-14" cy="14" r="6" fill="#E5383B"/><circle cx="20" cy="14" r="6" fill="#E5383B"/>`;
  return t+`</g>`; }
function pie(x,y,s=1){ return `<g transform="translate(${x},${y}) scale(${s})"><ellipse cx="0" cy="6" rx="48" ry="15" fill="#E9E4DA" stroke="${OL}" stroke-width="3.5"/><path d="M-40,2 L-36,-14 Q0,-26 36,-14 L40,2 Q0,14 -40,2Z" fill="#D9822B" stroke="${OL}" stroke-width="3.5"/><path d="M-36,-14 Q0,-26 36,-14" stroke="#E9A85A" stroke-width="8" fill="none"/><path d="M-12,-20 q8,-6 18,0" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round"/></g>`; }
function candle(x,y,h=46){ const f=1+0.12*Math.sin(T*17+x)+0.08*Math.sin(T*29+x); return `<g transform="translate(${x},${y})"><circle cx="0" cy="${-h-12}" r="26" fill="url(#candleGlow)"/><rect x="-6" y="${-h}" width="12" height="${h}" rx="3" fill="#F6EBD0" stroke="${OL}" stroke-width="3"/><path d="M0,${-h-2} q-7,-10 0,${-20*f} q7,${10*f} 0,${20*f}Z" fill="#FFC23D" stroke="#E58A1F" stroke-width="2"/><ellipse cx="0" cy="2" rx="14" ry="5" fill="#C9A44A" stroke="${OL}" stroke-width="2.5"/></g>`; }
function gravyBoat(x,y,s=1){ return `<g transform="translate(${x},${y}) scale(${s})"><path d="M-28,-14 L30,-14 Q40,-24 52,-22 Q40,-10 30,0 Q0,16 -28,0 Q-40,-8 -28,-14Z" fill="#F7F4EE" stroke="${OL}" stroke-width="3.5" stroke-linejoin="round"/><path d="M-24,-14 L28,-14" stroke="#8A4A22" stroke-width="6"/><path d="M-30,-10 q-14,2 -10,12" stroke="${OL}" stroke-width="3.5" fill="none"/></g>`; }
function glass(x,y){ return `<g transform="translate(${x},${y})"><path d="M-10,-40 L10,-40 L8,0 L-8,0Z" fill="#CFE8F5" fill-opacity=".7" stroke="${OL}" stroke-width="3"/><rect x="-8" y="-20" width="16" height="20" fill="#9FD0EE" opacity=".6"/></g>`; }
function bin(x,y,o={}){ const tip=o.tip||0, lid=o.lid==null?1:o.lid; let s='';
  s+=`<g transform="translate(${x},${y}) rotate(${tip*84},34,0)">`;
  s+=`<path d="M-38,-104 L38,-104 L32,0 L-32,0Z" fill="#8FA3B4" stroke="${OL}" stroke-width="4" stroke-linejoin="round"/><path d="M-20,-96 L-18,-8 M0,-96 L0,-8 M20,-96 L18,-8" stroke="#7A8EA0" stroke-width="4"/>`;
  if(lid>0.05 && !o.noBag) s+=`<path d="M-36,-104 Q-44,-130 -18,-128 Q0,-140 20,-128 Q44,-132 36,-104Z" fill="#2E3238" stroke="${OL}" stroke-width="3.5"/>`+boneProp(-6,-124,-30,0.55,false)+skinBit(16,-126,10,0.6);
  s+=`<rect x="-14" y="-4" width="28" height="8" rx="3" fill="#5A6878" stroke="${OL}" stroke-width="3"/>`;
  s+=`<g transform="rotate(${-lid*72},-40,-106)"><rect x="-44" y="-114" width="88" height="12" rx="5" fill="#A8B8C6" stroke="${OL}" stroke-width="4"/><rect x="-12" y="-122" width="24" height="9" rx="4" fill="#5A6878" stroke="${OL}" stroke-width="3"/></g>`;
  return s+`</g>`; }
function bowl(x,y,full=true){ return `<g transform="translate(${x},${y})"><path d="M-40,-22 L40,-22 L32,0 L-32,0Z" fill="#3E6FC0" stroke="${OL}" stroke-width="4" stroke-linejoin="round"/>${full?`<ellipse cx="0" cy="-24" rx="38" ry="9" fill="#8A5A36" stroke="${OL}" stroke-width="3"/><circle cx="-14" cy="-28" r="5" fill="#A8703F"/><circle cx="6" cy="-30" r="5" fill="#A8703F"/><circle cx="20" cy="-26" r="5" fill="#A8703F"/>`:''}<text x="0" y="-6" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">DOG</text></g>`; }
function toy(x,y,r=0){ return `<g transform="translate(${x},${y}) rotate(${r})"><circle r="18" fill="#E5383B" stroke="${OL}" stroke-width="3.5"/><path d="M-17,-5 Q0,4 17,-5" stroke="#fff" stroke-width="4" fill="none"/></g>`; }
// ---------- DOG (side / 3-4 view, faces right; flip faces left) ----------
function dogHead(o){ const ears=o.ears||0, eyes=o.eyes||'normal', m=clamp(o.mouth||0), lx=o.lookX||0, ly=o.lookY||0; let s='';
  const earRot=12+ears*22+Math.sin(T*3+1)*2;
  s+=`<g transform="rotate(${earRot},2,-78)"><path d="M6,-82 C-26,-84 -34,-26 -18,-6 C-6,6 12,-34 16,-74Z" fill="#5E3A20" stroke="${OL}" stroke-width="4"/></g>`; // far ear
  s+=`<circle cx="18" cy="-50" r="47" fill="${FUR}" stroke="${OL}" stroke-width="4.5"/>`;
  s+=`<path d="M30,-96 Q22,-60 40,-30 Q52,-40 50,-64 Q46,-88 30,-96Z" fill="${CREAM}"/>`;
  // open mouth (dark) behind the jaw
  if(m>0.04) s+=`<path d="M34,-24 Q60,-26 86,-30 Q76,${-8+m*24} 40,${-6+m*20}Z" fill="#6B2430" stroke="${OL}" stroke-width="3"/>`;
  if(o.bite) s+=boneProp(70,-20+m*10,8,0.62,true);
  if(o.tongue) s+=`<path d="M52,${-10+m*14} q10,${18+o.tongue*10} 22,0" fill="#F27C93" stroke="${OL}" stroke-width="3"/>`;
  s+=`<g transform="rotate(${m*24},36,-24)"><ellipse cx="58" cy="-14" rx="24" ry="9" fill="${CREAM}" stroke="${OL}" stroke-width="3.5"/></g>`;
  s+=`<ellipse cx="58" cy="-34" rx="32" ry="21" fill="${CREAM}" stroke="${OL}" stroke-width="4"/>`;
  const ch=o.chew?Math.abs(Math.sin(T*16))*3:0;
  s+=`<path d="M60,${-22+ch} Q70,${-16+ch} 82,${-22+ch}" stroke="${OL}" stroke-width="3" fill="none" stroke-linecap="round"/>`;
  s+=`<ellipse cx="84" cy="-44" rx="12" ry="9" fill="#2A1E1C"/><ellipse cx="80" cy="-48" rx="4" ry="2.6" fill="#fff" opacity=".7"/>`;
  // eyes
  const eye=(ex,ey,r)=>{
    if(eyes==='closed'||o.blink) return `<path d="M${ex-r},${ey} Q${ex},${ey+r*0.6} ${ex+r},${ey}" stroke="${OL}" stroke-width="4" fill="none" stroke-linecap="round"/>`;
    if(eyes==='happy') return `<path d="M${ex-r},${ey+2} Q${ex},${ey-r} ${ex+r},${ey+2}" stroke="${OL}" stroke-width="4.5" fill="none" stroke-linecap="round"/>`;
    const sad=eyes==='sad', sick=eyes==='sick', big=sad?1.25:1;
    let e=`<circle cx="${ex}" cy="${ey}" r="${r*big}" fill="#fff" stroke="${OL}" stroke-width="3.5"/><circle cx="${ex+lx}" cy="${ey+ly}" r="${r*big*(sad?0.78:0.6)}" fill="#2A1E1C"/>`;
    e+=`<circle cx="${ex+lx+r*0.3}" cy="${ey+ly-r*0.35}" r="${r*0.32*big}" fill="#fff"/>`;
    if(sad) e+=`<circle cx="${ex+lx-r*0.3}" cy="${ey+ly+r*0.3}" r="${r*0.16*big}" fill="#fff"/>`;
    if(sick) e+=`<path d="M${ex-r-2},${ey-r-2} L${ex+r+2},${ey-r-2} L${ex+r+2},${ey+1} Q${ex},${ey-3} ${ex-r-2},${ey+1}Z" fill="${FUR}" stroke="${OL}" stroke-width="3"/>`;
    if(sad||sick) e+=`<path d="M${ex-r},${ey-r*1.7} Q${ex},${ey-r*2.1-2} ${ex+r*0.9},${ey-r*2.4}" stroke="${OL}" stroke-width="3.5" fill="none" stroke-linecap="round"/>`;
    return e; };
  s+=eye(24,-62,11)+eye(52,-64,9.5);
  if(o.tear) s+=`<path d="M24,${-48+o.tear*10} q-4,8 0,12 q4,-4 0,-12Z" fill="#9FD6F5" stroke="${OL}" stroke-width="2"/>`;
  s+=`<g transform="rotate(${earRot},0,-80)"><path d="M2,-86 C-34,-88 -44,-20 -24,2 C-10,14 10,-36 12,-78Z" fill="${EAR}" stroke="${OL}" stroke-width="4.5"/><path d="M-6,-70 C-20,-56 -24,-30 -18,-12" stroke="#94603A" stroke-width="5" fill="none" stroke-linecap="round"/></g>`; // near ear
  if(o.cone) s+=`<path d="M-14,-118 L120,-150 L120,64 L-14,28 Z" fill="#EAF6FF" fill-opacity=".55" stroke="#7FA9C9" stroke-width="5" stroke-linejoin="round"/><path d="M-14,-118 L-14,28" stroke="#7FA9C9" stroke-width="10"/>`;
  return s; }
function tailSvg(x,y,wag,base){ const a=base+wag; return `<g transform="translate(${x},${y}) rotate(${a})"><path d="M0,0 C-26,-6 -44,-30 -46,-66" stroke="${OL}" stroke-width="22" fill="none" stroke-linecap="round"/><path d="M0,0 C-26,-6 -44,-30 -46,-66" stroke="${FUR}" stroke-width="14" fill="none" stroke-linecap="round"/><circle cx="-46" cy="-66" r="7" fill="${CREAM}"/></g>`; }
function dog(o){ const pose=o.pose||'sit', s=o.s||0.78; let b='';
  const wag=(o.wag||0)*Math.sin(T*(o.wagSpd||18))*24;
  const collar=(x,y,r)=>`<g transform="translate(${x},${y}) rotate(${r})"><rect x="-30" y="-8" width="60" height="16" rx="7" fill="#D8433C" stroke="${OL}" stroke-width="3.5"/><circle cx="18" cy="14" r="8" fill="#F6C945" stroke="${OL}" stroke-width="3"/></g>`;
  const legC=(x1,y1,x2,y2,c,w=22)=>`<path d="M${x1},${y1} L${x2},${y2}" stroke="${OL}" stroke-width="${w+8}" stroke-linecap="round"/><path d="M${x1},${y1} L${x2},${y2}" stroke="${c}" stroke-width="${w}" stroke-linecap="round"/><ellipse cx="${x2+5}" cy="${y2+2}" rx="15" ry="8" fill="${CREAM}" stroke="${OL}" stroke-width="3"/>`;
  const head=(nx,ny,ang)=>g(`translate(${nx},${ny}) rotate(${ang})`,dogHead(o));
  const breath=Math.sin(T*(o.breathSpd||3))*1.5;
  if(pose==='sit'){ const rise=o.rise||0;
    b+=tailSvg(-62,-24,wag,o.tailBase==null?-10:o.tailBase);
    b+=`<ellipse cx="-30" cy="-50" rx="56" ry="50" fill="${FURD}" stroke="${OL}" stroke-width="4.5"/>`;
    b+=`<ellipse cx="2" cy="-8" rx="32" ry="11" fill="${CREAM}" stroke="${OL}" stroke-width="3.5"/>`;
    b+=legC(30,-90-rise*20,34,-8,FURD);
    b+=`<g transform="rotate(${-58-rise*14},10,-100)"><ellipse cx="10" cy="-100" rx="${72+breath}" ry="${44+breath}" fill="${FUR}" stroke="${OL}" stroke-width="4.5"/></g>`;
    b+=`<g transform="rotate(-18,40,-118)"><ellipse cx="40" cy="-118" rx="22" ry="34" fill="${CREAM}"/></g>`;
    const pawUp=o.pawUp||0;
    b+=legC(54,-96-rise*20,mix(60,84,pawUp),mix(-8,-70,pawUp),FUR);
    b+=collar(44,-152-rise*24,-24);
    b+=head(48,-150-rise*26,(o.headAng||0)-rise*10);
  } else if(pose==='walk'){ const ph=o.walk||0, sw=k=>Math.sin(ph*Math.PI*2+k)*16, lf=k=>Math.max(0,Math.sin(ph*Math.PI*2+k))*7;
    const bob=Math.abs(Math.sin(ph*Math.PI*2))*3;
    b+=legC(-54,-80,-54+sw(Math.PI),-8-lf(Math.PI),FURD)+legC(42,-80,42+sw(0),-8-lf(0),FURD);
    b+=tailSvg(-80,-108-bob,wag,o.tailBase==null?30:o.tailBase);
    b+=`<ellipse cx="0" cy="${-98-bob}" rx="${88+breath}" ry="${40+breath}" fill="${FUR}" stroke="${OL}" stroke-width="4.5"/><ellipse cx="18" cy="${-74-bob}" rx="50" ry="14" fill="${CREAM}" opacity=".9"/>`;
    b+=legC(-38,-80,-38+sw(0),-8-lf(0),FUR)+legC(58,-80,58+sw(Math.PI),-8-lf(Math.PI),FUR);
    b+=collar(74,-124-bob,-60);
    b+=head(76,-126-bob,o.headAng||0);
  } else if(pose==='lie'){
    b+=`<path d="M-104,-22 C-140,-18 -160,-14 -178,-8" stroke="${OL}" stroke-width="22" fill="none" stroke-linecap="round"/><path d="M-104,-22 C-140,-18 -160,-14 -178,-8" stroke="${FUR}" stroke-width="14" fill="none" stroke-linecap="round"/>`;
    b+=`<ellipse cx="-14" cy="${-42-breath}" rx="${100}" ry="${36+breath}" fill="${FUR}" stroke="${OL}" stroke-width="4.5"/>`;
    b+=`<ellipse cx="-66" cy="-30" rx="40" ry="26" fill="${FURD}" stroke="${OL}" stroke-width="4"/><ellipse cx="-36" cy="-8" rx="30" ry="9" fill="${CREAM}" stroke="${OL}" stroke-width="3"/>`;
    b+=`<path d="M44,-18 L118,-10" stroke="${OL}" stroke-width="28" stroke-linecap="round"/><path d="M44,-18 L118,-10" stroke="${FUR}" stroke-width="20" stroke-linecap="round"/><ellipse cx="124" cy="-9" rx="15" ry="9" fill="${CREAM}" stroke="${OL}" stroke-width="3"/>`;
    b+=collar(70,-62,-70);
    b+=head(70,-44,o.headAng==null?24:o.headAng);
    b+=`<path d="M30,-6 L104,0" stroke="${OL}" stroke-width="28" stroke-linecap="round"/><path d="M30,-6 L104,0" stroke="${FUR}" stroke-width="20" stroke-linecap="round"/><ellipse cx="110" cy="0" rx="15" ry="9" fill="${CREAM}" stroke="${OL}" stroke-width="3"/>`;
  }
  if(o.bandage) b+=`<rect x="-40" y="-60" width="56" height="26" rx="6" fill="#fff" stroke="${OL}" stroke-width="3"/><path d="M-12,-56 L-12,-38 M-21,-47 L-3,-47" stroke="#E5383B" stroke-width="5"/>`;
  return g(`translate(${o.x},${o.y}) scale(${(o.flip?-1:1)*s},${s})`,b); }
// ---------- ROOM (dining room, Thanksgiving evening) ----------
function leafGarland(x0,x1,y){ let s=`<path d="M${x0},${y} Q${(x0+x1)/2},${y+40} ${x1},${y}" stroke="#6B4A2A" stroke-width="4" fill="none"/>`; const cols=['#D9682F','#E9A23B','#B8432E','#C98A2E'];
  for(let i=0;i<=10;i++){ const k=i/10, x=mix(x0,x1,k), yy=y+40*4*k*(1-k)*0.5*2*0.5+Math.sin(T*1.2+i)*1.5; s+=`<g transform="translate(${x},${yy+6}) rotate(${i*37})"><path d="M0,-12 L4,-4 L12,-4 L6,2 L8,10 L0,6 L-8,10 L-6,2 L-12,-4 L-4,-4Z" fill="${cols[i%4]}" stroke="${OL}" stroke-width="2"/></g>`; }
  return s; }
function windowEve(x0,y0,w,h,late){ let s=`<clipPath id="wev"><rect x="${x0}" y="${y0}" width="${w}" height="${h}"/></clipPath><g clip-path="url(#wev)">`;
  s+=`<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="url(#eveSky)"/><rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="#141A3C" opacity="${0.75*late}"/>`;
  s+=`<circle cx="${x0+w*0.72}" cy="${y0+h*0.3}" r="20" fill="#FFF3C4" opacity="${0.4+0.6*late}"/>`;
  s+=`<path d="M${x0},${y0+h} L${x0},${y0+h-50} Q${x0+60},${y0+h-80} ${x0+120},${y0+h-56} Q${x0+170},${y0+h-74} ${x0+w},${y0+h-60} L${x0+w},${y0+h}Z" fill="${lc('#5A3A5A','#1A1830',late)}"/>`;
  s+=`<path d="M${x0+40},${y0+h} L${x0+46},${y0+h-120} M${x0+46},${y0+h-90} L${x0+80},${y0+h-130} M${x0+44},${y0+h-60} L${x0+12},${y0+h-104} M${x0+62},${y0+h-108} L${x0+60},${y0+h-150}" stroke="${lc('#3A2438','#0E0C1C',late)}" stroke-width="6" stroke-linecap="round"/>`;
  for(let i=0;i<4;i++){ const p=((T*0.25+i*0.27)%1); s+=`<g transform="translate(${x0+30+i*44+Math.sin(T*2+i)*14},${y0+p*h}) rotate(${T*90+i*60})"><path d="M0,-6 L5,0 L0,6 L-5,0Z" fill="${['#D9682F','#E9A23B'][i%2]}" opacity="${1-late*0.6}"/></g>`; }
  for(let i=0;i<4;i++) s+=`<rect x="${x0+100+i*22}" y="${y0+h-46+(i%2)*10}" width="8" height="10" fill="#FFD27A" opacity="${0.4+0.5*late}"/>`;
  return s+`</g>`; }
function room(o){ const late=o.late||0; let s='';
  s+=`<rect x="-900" y="-700" width="3000" height="1200" fill="${lc('#B5543A','#7A3428',late)}"/>`;
  for(let x=-900;x<2100;x+=56) s+=`<rect x="${x}" y="-700" width="20" height="1200" fill="${lc('#C2654A','#853C2E',late)}" opacity=".8"/>`;
  for(let x=-880;x<2100;x+=56) for(let y=-660;y<330;y+=70) s+=`<path d="M${x+38},${y+((x/56)%2)*35} l5,6 l-5,6 l-5,-6Z" fill="${lc('#E08A5E','#9A4A36',late)}" opacity=".7"/>`;
  // wainscoting
  s+=`<rect x="-900" y="330" width="3000" height="${FLOOR-330}" fill="${lc('#E9DCC4','#A89A84',late)}"/><rect x="-900" y="322" width="3000" height="14" fill="${lc('#8E5E3C','#5E3E28',late)}"/>`;
  for(let x=-880;x<2100;x+=120) s+=`<rect x="${x}" y="356" width="96" height="${FLOOR-380}" rx="4" fill="none" stroke="${lc('#D3C2A4','#8E806A',late)}" stroke-width="4"/>`;
  // window + curtains + garland
  s+=windowEve(60,70,200,200,late);
  s+=`<rect x="56" y="66" width="208" height="208" fill="none" stroke="#F4EEE4" stroke-width="10"/><path d="M160,70 L160,270 M60,170 L260,170" stroke="#F4EEE4" stroke-width="7"/><rect x="46" y="270" width="228" height="14" rx="4" fill="#F4EEE4"/>`;
  const sw=Math.sin(T*0.8)*3;
  s+=`<path d="M22,40 L82,40 Q76,170 ${66+sw},300 L18,300Z" fill="${lc('#6E8B4A','#4A5E32',late)}" stroke="${OL}" stroke-width="4"/><path d="M238,40 L298,40 L302,300 L${252+sw},300 Q244,170 238,40Z" fill="${lc('#6E8B4A','#4A5E32',late)}" stroke="${OL}" stroke-width="4"/>`;
  s+=`<rect x="10" y="30" width="300" height="12" rx="6" fill="#7A5236"/>`+leafGarland(20,300,44);
  // framed picture (dog portrait!) + wreath
  s+=`<g transform="translate(860,150) rotate(-2)"><rect x="-64" y="-74" width="128" height="148" rx="6" fill="#C9A44A" stroke="${OL}" stroke-width="4"/><rect x="-50" y="-60" width="100" height="120" fill="${lc('#F4E3C8','#B8A88E',late)}"/><g transform="translate(-8,58) scale(.42)">${dogHead({eyes:'happy',tongue:1,mouth:0.4})}</g><text y="52" text-anchor="middle" font-size="14" font-weight="800" fill="#7A4A2A">BUDDY</text></g>`;
  s+=`<g transform="translate(600,120)"><circle r="46" fill="none" stroke="#C98A2E" stroke-width="16"/>`+Array.from({length:10},(_,i)=>`<g transform="rotate(${i*36}) translate(46,0) rotate(${i*50})"><path d="M0,-10 L4,-3 L10,-3 L5,2 L7,9 L0,5 L-7,9 L-5,2 L-10,-3 L-4,-3Z" fill="${['#D9682F','#B8432E','#E9A23B'][i%3]}" stroke="${OL}" stroke-width="2"/></g>`).join('')+`<path d="M-12,40 L0,62 L12,40Z" fill="#B8432E" stroke="${OL}" stroke-width="2.5"/></g>`;
  // pendant lamp
  s+=`<path d="M430,-700 L430,40" stroke="${OL}" stroke-width="4"/><path d="M380,80 L480,80 L456,36 L404,36Z" fill="#E9A23B" stroke="${OL}" stroke-width="4"/><circle cx="430" cy="300" r="380" fill="url(#lampWarm)" opacity="${0.8+0.15*late}"/>`;
  // floor + rug
  s+=`<rect x="-900" y="${FLOOR}" width="3000" height="600" fill="${lc('#9A6A42','#5E4028',late)}"/>`;
  for(let y=FLOOR+22;y<FLOOR+300;y+=26) s+=`<path d="M-900,${y} L2100,${y}" stroke="${lc('#86592F','#4E3420',late)}" stroke-width="3"/>`;
  for(let i=0;i<40;i++){ const y=FLOOR+((i%8)*26), x=-860+((i*271)%2900); s+=`<path d="M${x},${y} L${x},${y+26}" stroke="${lc('#86592F','#4E3420',late)}" stroke-width="3"/>`; }
  s+=`<ellipse cx="560" cy="${FLOOR+12}" rx="420" ry="34" fill="${lc('#6E8B4A','#3E4E2A',late)}"/><ellipse cx="560" cy="${FLOOR+12}" rx="380" ry="25" fill="none" stroke="${lc('#E9C77A','#9A8450',late)}" stroke-width="5" stroke-dasharray="16 10"/>`;
  return s; }
function table(o){ const late=o.late||0; let s='';
  // back chairs
  for(const cx of [260,700]) s+=`<path d="M${cx-40},470 L${cx-40},330 Q${cx},300 ${cx+40},330 L${cx+40},470Z" fill="#7A4A2A" stroke="${OL}" stroke-width="4"/><path d="M${cx-24},340 L${cx-24},460 M${cx},334 L${cx},460 M${cx+24},340 L${cx+24},460" stroke="#5E3820" stroke-width="5"/>`;
  // top + cloth
  s+=`<path d="M150,452 L1010,452 L1030,560 L130,560Z" fill="${lc('#F4EEE4','#B8B0A2',late)}" stroke="${OL}" stroke-width="4.5" stroke-linejoin="round"/>`;
  for(let x=180;x<1000;x+=70) s+=`<path d="M${x},466 Q${x+10},520 ${x-6},556" stroke="${lc('#DCD3C4','#9A9284',late)}" stroke-width="4" fill="none"/>`;
  s+=`<path d="M420,452 L560,452 L566,560 L414,560Z" fill="#D9682F" opacity=".9"/><path d="M414,560 L566,560 L560,574 L420,574Z" fill="#B8532A"/>`;
  s+=`<rect x="160" y="556" width="20" height="${FLOOR-556}" fill="#5E3820" stroke="${OL}" stroke-width="3"/><rect x="980" y="556" width="20" height="${FLOOR-556}" fill="#5E3820" stroke="${OL}" stroke-width="3"/>`;
  s+=`<rect x="150" y="444" width="860" height="12" rx="5" fill="${lc('#FFFFFF','#C8C0B2',late)}" stroke="${OL}" stroke-width="3.5"/>`;
  // food on the table
  s+=turkeyBird(300,436,1.05,o.missing);
  s+=candle(470,444)+candle(500,446,36);
  s+=pie(650,440,1)+gravyBoat(760,438,0.9)+glass(820,442)+glass(196,442);
  s+=plate(900,446,0.9,o.plateBone?boneProp(0,-4,10,0.5,false):'');
  return s; }
// ---------- hero ----------
const PLATE_L=(x,y)=>plate(x-6,y-6,0.75,`<path d="M-16,-10 Q0,-18 16,-10 L14,0 Q0,4 -14,0Z" fill="#E7C7A0" stroke="${OL}" stroke-width="2.5"/>`);
function heroAt(o){ return person(Object.assign({x:HX,y:FLOOR,s:1.0,face:'neutral',seed:2,blink:blinkAt(T,2),mouth:envOf('hero')},o),HERO); }
const PLATE_LB=(x,y)=>plate(x-6,y-6,0.75,`<path d="M-16,-10 Q0,-18 16,-10 L14,0 Q0,4 -14,0Z" fill="#E7C7A0" stroke="${OL}" stroke-width="2.5"/>`+boneProp(4,-14,12,0.5,true));
const BONE_R=(x,y)=>boneProp(x+16,y-4,-20,0.9,true);
// ---------- overlays ----------
function wagMeter(lv,k=1){ if(k<=0.01) return ''; const red=lv<0.35, col=lv>0.66?'#3FB27F':lv>0.35?'#F6C945':'#FF5E4E'; const fl=red?(0.75+0.25*Math.sin(T*14)):1;
  return `<g transform="translate(40,26) scale(${k})"><rect x="0" y="0" width="270" height="64" rx="14" fill="#2a2018" stroke="${red?'#FF6B5E':'#fff'}" stroke-width="3"/><text x="16" y="42" font-size="26" font-weight="800" fill="#fff">WAG</text><rect x="100" y="20" width="150" height="26" rx="9" fill="#4a4038"/><rect x="100" y="20" width="${150*clamp(lv)}" height="26" rx="9" fill="${col}" opacity="${fl}"/><path d="M125,20 L125,46 M150,20 L150,46 M175,20 L175,46 M200,20 L200,46 M225,20 L225,46" stroke="#2a2018" stroke-width="2" opacity=".5"/></g>`; }
function poll(x,y,sc,st={}){ if(sc<=0.01) return ''; const fill=clamp(st.fill==null?1:st.fill); let s='';
  s+=`<rect x="-280" y="-96" width="560" height="192" rx="22" fill="#fff" stroke="#2a2018" stroke-width="5"/><text x="0" y="-56" text-anchor="middle" font-size="30" font-weight="800" fill="#2a2018">GIVE HIM THE BONE?</text>`;
  const row=(yy,txt,pct,cross,ok)=>{ let r=`<rect x="-256" y="${yy-24}" width="512" height="48" rx="14" fill="#F1ECE6"/><rect x="-256" y="${yy-24}" width="${512*pct*fill}" height="48" rx="14" fill="${ok?'#3FB27F':cross?'#E5383B':'#F6C945'}" opacity="${ok||cross?0.9:0.75}"/><text x="-238" y="${yy+10}" font-size="26" font-weight="800" fill="#2a2018">${txt}</text><text x="242" y="${yy+10}" text-anchor="end" font-size="26" font-weight="800" fill="#2a2018">${Math.round(pct*100*fill)}%</text>`;
    if(cross) r+=`<path d="M-250,${yy} L${-250+500*cross},${yy}" stroke="#2a2018" stroke-width="6" stroke-linecap="round"/>`;
    if(ok) r+=`<g transform="translate(272,${yy-22}) scale(${ok})"><circle r="24" fill="#3FB27F" stroke="#fff" stroke-width="4"/><path d="M-11,0 L-3,8 L12,-8" stroke="#fff" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g>`; return r; };
  s+=row(-6,'GIVE IT! JUST ONE',0.78,st.cross||0,0)+row(56,'NO WAY',0.22,0,st.ok||0);
  return `<g transform="translate(${x},${y}) scale(${sc})">${s}</g>`; }
function arrowLbl(x,y,txt,sc,col='#F6C945',fg='#2a2018'){ if(sc<=0.01) return ''; return `<g transform="translate(${x},${y}) scale(${sc})"><rect x="${-txt.length*9.5-18}" y="-62" width="${txt.length*19+36}" height="44" rx="14" fill="${col}" stroke="#2a2018" stroke-width="4"/><text y="-31" text-anchor="middle" font-size="27" font-weight="800" fill="${fg}">${txt}</text><path d="M-14,-18 L14,-18 L0,0Z" fill="${col}" stroke="#2a2018" stroke-width="4" stroke-linejoin="round"/></g>`; }
function clockSpin(x,y,k,turns){ if(k<=0.01) return ''; const a=turns*360; return `<g transform="translate(${x},${y}) scale(${k})"><circle r="74" fill="#F4F1EC" stroke="#2a2018" stroke-width="7"/>${Array.from({length:12},(_,i)=>`<path d="M${Math.sin(i*Math.PI/6)*58},${-Math.cos(i*Math.PI/6)*58} L${Math.sin(i*Math.PI/6)*66},${-Math.cos(i*Math.PI/6)*66}" stroke="#2a2018" stroke-width="${i%3?3:6}"/>`).join('')}<g transform="rotate(${a})"><path d="M0,6 L0,-56" stroke="#2a2018" stroke-width="5" stroke-linecap="round"/></g><g transform="rotate(${a/12+200})"><path d="M0,6 L0,-36" stroke="#E5383B" stroke-width="8" stroke-linecap="round"/></g><circle r="7" fill="#2a2018"/></g>`; }
function stopwatch(x,y,k,txt){ if(k<=0.01) return ''; return `<g transform="translate(${x},${y}) scale(${k})"><rect x="-10" y="-62" width="20" height="14" rx="4" fill="#2a2018"/><circle r="48" fill="#fff" stroke="#2a2018" stroke-width="7"/><text y="12" text-anchor="middle" font-size="32" font-weight="800" fill="#E5383B">${txt}</text></g>`; }
// dog X-ray: side profile with throat + stomach. st:{flow 0..1 bone progress, stuckT, stuckB, big}
function dogXray(st){ let s='';
  const shapes=[
    `<ellipse cx="50" cy="40" rx="150" ry="62"/>`,
    `<path d="M-90,10 L-40,-30 L10,0 L-30,60Z"/>`,
    `<circle cx="-120" cy="-46" r="50"/>`,
    `<path d="M-150,-62 Q-200,-56 -206,-30 Q-204,-8 -150,-6Z"/>`,
    `<rect x="-60" y="60" width="34" height="120" rx="14"/>`,`<rect x="-14" y="60" width="34" height="120" rx="14"/>`,
    `<rect x="120" y="60" width="34" height="120" rx="14"/>`,`<rect x="164" y="56" width="34" height="124" rx="14"/>`,
    `<path d="M190,20 Q240,0 250,-60" stroke-width="24" fill="none" stroke-linecap="round"/>`];
  s+=`<g stroke="#7CC4F0" stroke-width="12" fill="#7CC4F0" stroke-linejoin="round">${shapes.join('')}</g>`;
  s+=`<g fill="#22325A" stroke="none">${shapes.slice(0,8).join('')}</g><path d="M190,20 Q240,0 250,-60" stroke="#22325A" stroke-width="12" fill="none" stroke-linecap="round"/>`;
  s+=`<path d="M-104,-84 C-70,-80 -64,-20 -84,0 C-96,8 -106,-40 -112,-80Z" fill="#2C3E6C" stroke="#7CC4F0" stroke-width="5"/>`;
  s+=`<circle cx="-140" cy="-62" r="8" fill="#7CC4F0"/><ellipse cx="-204" cy="-38" rx="9" ry="7" fill="#7CC4F0"/>`;
  // ribs / spine hint
  s+=`<path d="M-30,0 C40,-14 120,-12 190,10" stroke="#3E5A8E" stroke-width="8" fill="none"/>`;
  const PIPE='M-196,-14 C-160,-8 -120,0 -96,20 C-70,44 -30,52 10,52';
  s+=`<path d="${PIPE}" stroke="#F49AAE" stroke-width="18" fill="none" stroke-linecap="round" opacity=".95"/>`;
  s+=`<ellipse cx="46" cy="50" rx="46" ry="30" fill="#F49AAE" opacity=".9"/><path d="M86,62 C140,64 150,100 118,104 C88,108 84,82 56,90 C30,98 22,108 0,104" stroke="#F49AAE" stroke-width="15" fill="none" stroke-linecap="round" opacity=".9"/>`;
  const pts=[[-196,-14],[-160,-8],[-124,4],[-96,20],[-66,42],[-30,52],[10,52],[46,50],[86,62],[130,76],[124,102],[80,96],[40,98],[0,104]];
  const pos=k=>{ k=clamp(k)*(pts.length-1); const i=Math.min(pts.length-2,Math.floor(k)); const f=k-i; return [mix(pts[i][0],pts[i+1][0],f),mix(pts[i][1],pts[i+1][1],f)]; };
  const bs=st.bs||0.6;
  if(st.flow!=null){ const p=pos(st.flow); s+=boneProp(p[0],p[1],30+st.flow*200,bs,false);
    for(let i=1;i<3;i++){ const q=pos(st.flow-i*0.05); s+=shard(q[0],q[1],i*70+st.flow*300,bs*1.3); } }
  if(st.stuckT>0) s+=`<g transform="translate(-96,20)">${boneProp(0,0,62,bs,false)}<circle r="36" fill="none" stroke="#FF5E4E" stroke-width="7" opacity="${st.stuckT}"/></g>`;
  if(st.stuckB>0) s+=`<g transform="translate(118,90)">${boneProp(0,0,-20,bs,false)}<circle r="36" fill="none" stroke="#FF5E4E" stroke-width="7" opacity="${st.stuckB}"/></g>`;
  if(st.ouch>0) for(let i=0;i<5;i++){ const q=pos(0.15+i*0.17); s+=`<g transform="translate(${q[0]},${q[1]}) scale(${st.ouch*(0.8+0.3*Math.sin(T*12+i))})"><path d="M0,-18 L5,-6 L18,-8 L8,2 L14,14 L0,7 L-14,14 L-8,2 L-18,-8 L-5,-6Z" fill="#FF5E4E" stroke="#fff" stroke-width="2"/></g>`; }
  return s; }
function xrayInset(k,st,x=176,y=322){ if(k<=0.01) return ''; let s='';
  s+=`<circle r="124" fill="#14203A" stroke="#fff" stroke-width="6"/><clipPath id="xr"><circle r="120"/></clipPath><g clip-path="url(#xr)"><path d="M-130,-130 L130,130 M-60,-130 L130,60 M-130,-60 L60,130" stroke="#1E2C4A" stroke-width="10"/><g transform="translate(14,-20) scale(.5)">${dogXray(Object.assign({bs:0.8},st))}</g></g>`;
  s+=`<g transform="translate(0,-136)"><rect x="-70" y="-18" width="140" height="34" rx="12" fill="#2a2018" stroke="#fff" stroke-width="3"/><text y="7" text-anchor="middle" font-size="20" font-weight="800" fill="#F6C945">INSIDE</text></g>`;
  return `<g transform="translate(${x},${y}) scale(${k})">${s}</g>`; }

// ---------- timing ----------
const K=()=>({n1a:P_('n1.0'),n1b:P_('n1.1'),n1c:P_('n1.2'),h1:CLIP('h1').start,h10:P_('h1.0'),h11:P_('h1.1'),h11e:PE('h1.1'),
  n20:P_('n2.0'),n20e:PE('n2.0'),n21:P_('n2.1'),n21e:PE('n2.1'),n22:P_('n2.2'),n22e:PE('n2.2'),n23:P_('n2.3'),n23e:PE('n2.3'),n24:P_('n2.4')});
const FZ=()=>PE('n2.4')+0.3;
function wagLevel(t){ const k=K(); return kval(t,[[0,0.62],[k.h11e,0.62],[k.h11e+0.6,1],[k.n21,1],[k.n23-0.3,0.85],[k.n23+0.4,0.3],[k.n24,0.08]]); }
// screen helpers
let CAM={s:1,x:540,y:304};
const SX=wx=>540+(wx-CAM.x)*CAM.s, SY=wy=>304+(wy-CAM.y)*CAM.s;

// ---------- BAD PATH ----------
function badPath(t){
  let panel='', over='', cam={s:1,x:540,y:304}, shake=0; const k=K();
  const DROP=k.h11e-0.1, CATCH=DROP+0.32, GULP=k.n20+0.35;
  const TRASH=k.n21-0.15, HOUR=k.n23-0.3;
  if(t<TRASH){ // ---- S1: the bone over the dog
    panel+=room({late:0})+table({late:0,missing:true});
    // hero: right hand holds the bone above the dog, left hand holds her plate
    let o={face:'happy',lookX:5,lookY:3};
    const hold=armR(118,-196,-1), give=armR(142,-150,-1), rest=armR(70,-80);
    o.armL=armL(-60,-120); o.holdL=PLATE_L;
    if(t<k.h10){ const w=Math.sin(T*3)*6; o.armR=[hold[0]+w*0.3,hold[1]]; o.holdR=BONE_R; o.face=t<k.n1c?'happy':'grin'; }
    else if(t<DROP){ const kk=E(t,k.h10,k.h10+0.5); o.armR=lerpA(hold,give,kk); o.holdR=BONE_R; o.face='sheepish'; o.tilt=-5*kk; }
    else { const kk=E(t,DROP,DROP+0.4); o.armR=lerpA(give,rest,kk); o.face=t<k.n20+0.9?'happy':'neutral'; o.lookX=5; }
    // in "two seconds" she looks at the dog proudly, then turns to eat pie (oblivious)
    if(t>k.n20e-0.3){ const kk=E(t,k.n20e-0.3,k.n20e+0.2); o.armL=lerpA(armL(-60,-120),armL(-26,-206),kk); o.lookX=-6*kk; o.face=kk>0.5?'happy':o.face; o.blink=kk>0.6?1:o.blink; }
    panel+=heroAt(o);
    // dog: sits, sad eyes, begs; catches, gulps, happy wag
    let d={x:DX,y:FLOOR+2,flip:true,pose:'sit',eyes:'sad',ears:0.4,headAng:-24,lookX:-2,lookY:-3,wag:0.5,wagSpd:9};
    if(t<k.h10){ d.pawUp=E(t,k.n1b+0.3,k.n1b+0.6)*(1-E(t,k.n1c+0.1,k.n1c+0.4)); }
    if(t>=k.h10&&t<DROP){ d.wag=1; d.wagSpd=20; d.eyes='normal'; d.ears=-0.2; d.mouth=0.2; d.tongue=1; }
    if(t>=DROP-0.15&&t<CATCH+0.25){ const kk=E(t,DROP-0.15,CATCH); d.rise=Math.sin(clamp((t-DROP+0.15)/0.6)*Math.PI)*1; d.mouth=t<CATCH?0.9:0.2; d.headAng=-32; d.eyes='normal'; d.bite=t>=CATCH; d.wag=1; }
    if(t>=CATCH+0.25){ d.mouth=t<GULP?0.25:0; d.bite=t<GULP; d.chew=t<GULP; d.headAng=t<GULP+0.3?-36:-10; d.eyes=t<GULP+0.4?'closed':'happy'; d.wag=1; d.wagSpd=22; d.tongue=t>GULP+0.5?1:0; d.mouth=t>GULP+0.5?0.35:d.mouth; }
    panel+=dog(d);
    // falling bone
    if(t>=DROP&&t<CATCH){ const kk=(t-DROP)/(CATCH-DROP); const x0=HX+150, y0=FLOOR-210, x1=DX-62, y1=FLOOR-236; panel+=boneProp(mix(x0,x1,kk),mix(y0,y1,kk)-Math.sin(kk*Math.PI)*30,-20-kk*200,0.9*0.78/0.9,true); }
    cam={s:kval(t,[[0,1.32],[k.n1b,1.28],[k.n1c,1.2],[k.h10,1.22],[DROP,1.34],[k.n20,1.4],[TRASH,1.3]]),x:kval(t,[[0,590],[k.n1c,560],[k.h10,566],[DROP,600],[k.n20,575]]),y:kval(t,[[0,400],[k.n1c,410],[DROP,420]])};
    CAM=cam;
    // labels (frame 1: the danger is visible)
    if(t<k.h10){ const ko=1-A(t,k.n1c+0.05,k.n1c+0.3);
      over+=arrowLbl(SX(HX+176),SY(FLOOR-236),'TURKEY BONE',(t<0.05?1:popS(t,0))*ko,'#E5383B','#fff');
      if(t>=k.n1b+0.2) over+=arrowLbl(SX(DX+30),SY(FLOOR-300),'SAD EYES',popS(t,k.n1b+0.2)*ko,'#F6C945'); }
    if(t<k.n1c+0.35) over+=badge(540,560,'THANKSGIVING',{sc:popS(t,k.n1a)*(1-A(t,k.n1b+0.3,k.n1b+0.55)),fs:34,bg:'#D9682F',fg:'#fff',rot:-2});
    if(t>=k.n1c){ const kk=A(t,k.h10+0.55,k.h10+1.0); const out=1-A(t,k.n20-0.3,k.n20); over+=poll(mix(186,186,kk),mix(250,158,kk),mix(0.58,0.5,kk)*popS(t,k.n1c)*out,{fill:A(t,k.n1c+0.15,k.n1c+1.0)}); }
    // gulp: x-ray inset + stopwatch
    if(t>=k.n20-0.2){ const xk=popS(t,k.n20-0.1)*(1-A(t,TRASH-0.3,TRASH)); over+=xrayInset(xk,{flow:clamp((t-GULP+0.2)/1.4)});
      over+=stopwatch(SX(DX+10),SY(FLOOR-330),popS(t,k.n20+0.5)*(1-A(t,TRASH-0.3,TRASH)),t<k.n20+1.3?'0:0'+Math.min(2,Math.floor((t-k.n20)*1.6)):'0:02'); }
    if(t>=GULP&&t<GULP+0.9) over+=badge(SX(DX-40),SY(FLOOR-380),'GULP!',{sc:popS(t,GULP),fs:40,bg:'#fff',rot:-6});
    over+=wagMeter(wagLevel(t),1);
  } else if(t<HOUR){ // ---- S2: the trash bag
    panel+=room({late:0.15})+table({late:0.15,missing:true});
    let o={face:'happy',blink:1,lookX:-6,armL:armL(-26,-206),armR:armR(70,-80)}; o.holdL=(x,y)=>pie(x+4,y-6,0.35);
    panel+=heroAt(o);
    const W0=TRASH, W1=TRASH+0.9, KNOCK=W1+0.15;
    const wob=t>=KNOCK&&t<KNOCK+0.6?Math.sin((t-KNOCK)*30)*(1-(t-KNOCK)/0.6)*0.08:0;
    panel+=bin(BINX,FLOOR+2,{tip:wob,lid:1,noBag:t>=KNOCK});
    if(t>=KNOCK){ const sp=E(t,KNOCK,KNOCK+0.45), bx=BINX-60, fx=x=>mix(BINX-10,x,sp);
      panel+=`<path d="M${fx(bx-150)},${FLOOR+6} Q${fx(bx-100)},${mix(FLOOR-140,FLOOR-46,sp)} ${fx(bx-10)},${mix(FLOOR-130,FLOOR-36,sp)} Q${fx(bx+20)},${FLOOR-10} ${fx(bx+10)},${FLOOR+6}Z" fill="#2E3238" stroke="${OL}" stroke-width="3.5"/>`;
      panel+=skinBit(fx(bx-190),FLOOR-6,10,0.95)+fatBit(fx(bx-120),FLOOR-4,0.95)+boneProp(fx(bx-70),FLOOR-8,-14,0.6,false)+boneProp(fx(bx-20),FLOOR-2,30,0.5,false); }
    let d={pose:'walk',x:mix(DX,BINX-330,E(t,W0,W1)),y:FLOOR+2,flip:false,walk:(t-W0)*2.2,wag:1,wagSpd:16,eyes:'normal',ears:0,headAng:10};
    if(t>=W1){ d.walk=0; d.headAng=46+Math.sin(T*9)*8; d.eyes='closed'; d.mouth=0.3+0.3*Math.abs(Math.sin(T*8)); d.chew=1; d.x=BINX-330; }
    panel+=dog(d);
    cam={s:kval(t,[[TRASH,1.3],[W1,1.4],[HOUR,1.46]]),x:kval(t,[[TRASH,600],[W1,750],[HOUR,760]]),y:kval(t,[[TRASH,420],[W1,450],[HOUR,452]])};
    CAM=cam;
    if(t>=KNOCK&&t<KNOCK+0.8) over+=badge(SX(BINX+30),SY(FLOOR-190),'RIP!',{sc:popS(t,KNOCK),fs:38,bg:'#fff',rot:8});
    const lb=[['SKIN',k.n22,BINX-250,'#E9A23B',0],['FAT',k.n22+(k.n22e-k.n22)*0.33,BINX-180,'#FFF3C9',70],['MORE BONES',k.n22+(k.n22e-k.n22)*0.62,BINX-100,'#E5383B',0]];
    lb.forEach(([txt,ts,wx,col,dy],i)=>{ if(t>=ts) over+=arrowLbl(SX(wx),SY(FLOOR-24)-dy,txt,popS(t,ts),col,col==='#E5383B'?'#fff':'#2a2018'); });
    if(t>=k.n21+0.2&&t<KNOCK) over+=arrowLbl(SX(BINX),SY(FLOOR-150),'TRASH BAG',popS(t,k.n21+0.3),'#fff');
    if(t>=W0+0.3) over+=badge(SX(HX)+190,Math.max(130,SY(FLOOR-300)),'NOT WATCHING',{sc:popS(t,W0+0.4)*(1-A(t,k.n22-0.3,k.n22)),fs:26,bg:'#fff',rot:-3});
    over+=wagMeter(wagLevel(t),1);
  } else { // ---- S3: one hour later
    panel+=room({late:0.85})+table({late:0.85,missing:true});
    panel+=bin(BINX,FLOOR+2,{noBag:true})+`<path d="M${BINX-210},${FLOOR+6} Q${BINX-160},${FLOOR-46} ${BINX-70},${FLOOR-36} Q${BINX-40},${FLOOR-10} ${BINX-50},${FLOOR+6}Z" fill="#2E3238" stroke="${OL}" stroke-width="3.5"/>`+boneProp(BINX-130,FLOOR-6,-14,0.6,false);
    panel+=bowl(DX-190,FLOOR+10,true)+toy(DX+150,FLOOR-14,20);
    let o={face:'scared',lookX:5,lookY:4,armL:armL(-30,-214),armR:armR(30,-214),tilt:4};
    if(t>k.n23e) { o.armL=armL(-36,-226); o.armR=armR(36,-226); }
    panel+=heroAt(o);
    const sigh=Math.sin(T*1.6);
    let d={pose:'lie',x:DX+20,y:FLOOR+4,flip:true,eyes:'sick',ears:0.9,headAng:28,lookX:2,lookY:2,breathSpd:1.6,tear:clamp((t-k.n23-1.2)/1.2)};
    panel+=dog(d);
    panel+=`<rect x="-900" y="-700" width="3000" height="1500" fill="#0B0D2A" opacity=".16"/>`;
    cam={s:kval(t,[[HOUR,1.3],[k.n24,1.38],[FZ(),1.42]]),x:kval(t,[[HOUR,640],[FZ(),660]]),y:kval(t,[[HOUR,430],[FZ(),444]])};
    CAM=cam;
    const ck=popS(t,HOUR)*(1-A(t,k.n23+0.75,k.n23+1.05)); over+=clockSpin(540,250,ck,1.2*E(t,HOUR,k.n23+0.7));
    if(ck>0.01) over+=badge(540,372,'1 HOUR LATER',{sc:ck,fs:34,bg:'#fff'});
    const eat=k.n23+(k.n23e-k.n23)*0.52, play=k.n23+(k.n23e-k.n23)*0.8;
    if(t>=eat){ over+=arrowLbl(SX(DX-190),SY(FLOOR-50),'FULL BOWL',popS(t,eat),'#fff'); over+=stampX(SX(DX-190),SY(FLOOR-22),18,popS(t,eat+0.15)); }
    if(t>=play){ over+=arrowLbl(SX(DX+150),SY(FLOOR-44),'NO PLAY',popS(t,play),'#fff'); over+=stampX(SX(DX+150),SY(FLOOR-14),16,popS(t,play+0.15)); }
    if(t>=k.n24) over+=badge(540,548,'BAD IDEA',{sc:popS(t,k.n24+0.02),bg:'#E5383B',fg:'#fff',fs:46,rot:-3});
    over+=wagMeter(wagLevel(t),1);
  }
  return {panel,over,cam,shake};
}

// ---------- PAUSE DIAGRAM ----------
function pauseDiagram(t){ const v=P_('m1.1'), ve=PE('m1.1'), st=P_('m1.2'), ste=PE('m1.2'), rw=P_('m1.3'); let s='';
  const k0=A(t,v-0.45,v-0.05);
  s+=`<g opacity="${k0}">`;
  const thr=st+(ste-st)*0.36, bel=st+(ste-st)*0.78;
  const flow=t<thr?clamp((t-v-0.4)/(ve-v)) : null;
  s+=`<g transform="translate(730,300) scale(1.05)">${dogXray({flow:flow==null?null:flow*0.92,stuckT:t>=thr?A(t,thr,thr+0.2):0,stuckB:t>=bel?A(t,bel,bel+0.2):0,ouch:t>=v+(ve-v)*0.55&&t<thr?popS(t,v+(ve-v)*0.55):0})}</g>`;
  s+=badge(700,96,'VETS SAY',{sc:popS(t,v),fs:32,bg:'#fff'});
  if(t>=v+(ve-v)*0.55&&t<thr+0.1) s+=badge(720,566,'HURTS INSIDE',{sc:popS(t,v+(ve-v)*0.55),fs:30,bg:'#E5383B',fg:'#fff',rot:-2});
  if(t>=thr) s+=arrowLbl(629,262,'THROAT',popS(t,thr),'#E5383B','#fff');
  if(t>=bel) s+=arrowLbl(854,350,'BELLY',popS(t,bel),'#E5383B','#fff');
  s+=`</g>`;
  if(t>=ste-0.3) s+=poll(712,500,0.5*popS(t,ste-0.3),{cross:A(t,ste-0.1,ste+0.3),ok:popS(t,ste+0.2)});
  return s; }

// ---------- RIGHT MOVE ----------
function rightMove(t){
  let panel='', over='', cam={s:1,x:540,y:304}, shake=0;
  const a0=P_('n4.0'), a1=P_('n4.1'), a1e=PE('n4.1'), a2=P_('n4.2'), a3=P_('n4.3'), a4=P_('n4.4'), a4e=PE('n4.4'), a5=P_('n4.5'), a5e=PE('n4.5'), hS=CLIP('h2').start, h21=P_('h2.1');
  const CLOSE=a5+0.15;
  const give=a4+(a4e-a4)*0.45, take=give+0.35;
  if(t<CLOSE||t>=a5e+0.15){
    panel+=room({late:0})+table({late:0,missing:true,plateBone:t>=a2+0.6});
    panel+=bin(BINX,FLOOR+2,{lid:t<a5e+0.15?1:0});
    let o={face:'neutral',lookX:5,lookY:3};
    const hold=armR(118,-196,-1), rest=armR(70,-80), toPlate=armR(-46,-122,1), offer=armR(140,-150,-1);
    o.armL=armL(-60,-120); o.holdL=PLATE_L; o.armR=hold; o.holdR=BONE_R;
    if(t>=a2-0.1){ // take the bone back: put it on her own plate
      const kk=E(t,a2-0.1,a2+0.35), back=E(t,a2+0.45,a2+0.75);
      if(t<a2+0.4){ o.armR=lerpA(hold,toPlate,kk); o.holdR=kk<0.5?BONE_R:(x,y)=>boneProp(x-10,y+2,10,0.5,true); } else { o.armR=lerpA(toPlate,rest,back); o.holdR=null; o.holdL=PLATE_LB; }
      o.face='neutral'; o.lookX=-5; o.lookY=4; }
    if(t>=a2+0.4){ o.holdR=null; o.holdL=PLATE_LB; }
    if(t>=a3-0.1){ // no skin: lift the skin off her plate with the right hand
      const kk=E(t,a3-0.1,a3+0.3), back=E(t,a3+0.55,a3+0.85); o.armR=lerpA(rest,armR(-30,-130,-1),kk*(1-back)); o.lookX=-5; o.face='suspicious';
      if(kk>0.6&&t<a3+0.45) o.holdR=(x,y)=>skinBit(x+6,y-6,-20,0.7); o.holdL=PLATE_LB; }
    if(t>=a4-0.05) o.holdL=PLATE_LB;
    if(t>=a4-0.05){ const kk=E(t,a4,a4+0.3); o.armR=lerpA(armR(-30,-130,-1),armR(-40,-128,-1),kk); o.lookX=-4; o.face='neutral'; }
    if(t>=a4+0.3){ const kk=E(t,a4+0.3,give); o.armR=lerpA(armR(-40,-128,-1),offer,kk); o.lookX=5; o.face='happy'; if(t<take) o.holdR=(x,y)=>`<rect x="${x+8}" y="${y-12}" width="22" height="14" rx="5" fill="#E7C7A0" stroke="${OL}" stroke-width="2.5"/>`; }
    if(t>=take+0.2){ const kk=E(t,take+0.2,take+0.6); o.armR=lerpA(offer,rest,kk); o.face='happy'; }
    if(t>=hS){ o.face='happy'; o.mouth=envOf('hero'); o.lookX=5; if(t>=h21){ const kk=E(t,h21,h21+0.25); o.armR=lerpA(rest,armR(110,-210,-1),kk); o.handR=''; } }
    panel+=heroAt(o);
    // dog
    let d={x:DX,y:FLOOR+2,flip:true,pose:'sit',eyes:'sad',ears:0.4,headAng:-24,lookX:-2,lookY:-3,wag:0.5,wagSpd:9};
    if(t>=a1&&t<a2) { d.eyes='sad'; d.lookX=1; d.lookY=-1; d.tear=0.3+0.2*Math.sin(T*3); d.ears=0.7; d.pawUp=E(t,a1+0.2,a1+0.5)*(1-E(t,a1e-0.2,a1e+0.1)); }
    if(t>=a2&&t<give){ d.eyes='sad'; d.headAng=-18; d.lookX=t<a2+0.6?2:-2; }
    if(t>=give-0.1){ d.eyes=t<take+0.5?'normal':'happy'; d.mouth=t<take?0.5:0; d.chew=t>=take&&t<take+1.4; d.headAng=-28; d.wag=1; d.wagSpd=20; d.ears=-0.2; d.tongue=t>take+1.4?1:0; if(d.tongue) d.mouth=0.35; }
    if(t>=hS){ d.eyes=t<h21?'happy':'normal'; d.tongue=1; d.mouth=0.35; d.wag=1; d.wagSpd=22; d.headAng=t>=h21?-30:-26; }
    panel+=dog(d);
    if(t>=a3+0.45&&t<a3+1.05){ const kk=(t-a3-0.45)/0.6; const x=mix(HX-40,BINX,kk), y=mix(FLOOR-150,FLOOR-110,kk)-Math.sin(kk*Math.PI)*160; panel+=skinBit(x,y,kk*540,0.7); }
    const closeUp=t>=a1-0.05&&t<a2-0.05;
    if(t>=a5e+0.15) cam={s:1.3,x:570,y:410};
    else if(closeUp) cam={s:kval(t,[[a1-0.05,1.6],[a1+0.35,2.5],[a2-0.05,2.6]]),x:kval(t,[[a1-0.05,700],[a1+0.35,DX-50]]),y:kval(t,[[a1-0.05,430],[a1+0.35,FLOOR-190]])};
    else cam={s:kval(t,[[a0,1.32],[a2,1.3],[a3,1.24],[a4,1.32],[give,1.38],[a5,1.34]]),x:kval(t,[[a0,566],[a2,570],[a3,600],[a4,580],[give,590]]),y:kval(t,[[a0,400],[give,420]])};
    CAM=cam;
    if(t<a1-0.05) over+=badge(640,560,'SAME DINNER',{sc:popS(t,a0+0.1),bg:'#fff',fs:34,rot:-2});
    else if(closeUp){ over+=badge(780,540,'SAD EYES: 100%',{sc:popS(t,a1+0.3),bg:'#F6C945',fs:34,rot:-3});
      for(let i=0;i<4;i++){ const p=((T*1.1+i/4)%1)*0.7; over+=`<g transform="translate(${SX(DX-80)+Math.cos(i*1.7)*120*p},${SY(FLOOR-260)-p*80}) scale(${1-p})"><path d="M0,-14 L4,-4 L14,0 L4,4 L0,14 L-4,4 L-14,0 L-4,-4Z" fill="#FFF3A8" stroke="#2a2018" stroke-width="2"/></g>`; } }
    else if(t<a3) over+=badge(640,560,'NO BONES',{sc:popS(t,a2),bg:'#3FB27F',fg:'#fff',fs:40,rot:-2});
    else if(t<a4) over+=badge(640,560,'NO SKIN',{sc:popS(t,a3),bg:'#3FB27F',fg:'#fff',fs:40,rot:2});
    else if(t<CLOSE) over+=badge(640,560,'SMALL PLAIN PIECE',{sc:popS(t,a4+0.3),bg:'#3FB27F',fg:'#fff',fs:34});
    else if(t<hS) over+=badge(640,560,'TRASH: CLOSED',{sc:1,bg:'#3FB27F',fg:'#fff',fs:34});
    else if(t>=h21) over+=badge(660,560,'SAFE',{sc:popS(t,h21+0.05),bg:'#3FB27F',fg:'#fff',fs:46,rot:-3});
    else over+=badge(660,560,'GOOD BOY',{sc:popS(t,hS+0.05),bg:'#fff',fs:36,rot:2});
    over+=wagMeter(kval(t,[[a0,0.6],[give,0.62],[take+0.4,1]]),1);
  } else { // close-up: the hand closes the trash lid
    panel+=room({late:0})+table({late:0,missing:true,plateBone:true});
    const lid=1-E(t,CLOSE+0.35,CLOSE+0.75);
    panel+=bin(BINX,FLOOR+2,{lid});
    const hk=E(t,CLOSE,CLOSE+0.4)*(1-E(t,a5e-0.2,a5e+0.1));
    const hx=BINX-30+(1-lid)*20, hy=mix(FLOOR-420,FLOOR-190,hk)+(1-lid)*36;
    panel+=`<path d="M${BINX-70},${FLOOR-520} L${hx},${hy}" stroke="${OL}" stroke-width="40" stroke-linecap="round"/><path d="M${BINX-70},${FLOOR-520} L${hx},${hy}" stroke="${HERO.top}" stroke-width="32" stroke-linecap="round"/><circle cx="${hx}" cy="${hy}" r="17" fill="${HERO.skin}" stroke="${OL}" stroke-width="4"/>`;
    cam={s:kval(t,[[CLOSE,2.1],[a5e+0.15,2.25]]),x:BINX-20,y:FLOOR-130}; CAM=cam;
    if(t>=CLOSE+0.75) over+=badge(SX(BINX),SY(FLOOR-170),'CLICK!',{sc:popS(t,CLOSE+0.75),fs:36,bg:'#fff',rot:-6});
    over+=badge(640,560,'CLOSE THE TRASH',{sc:popS(t,CLOSE+0.05),bg:'#3FB27F',fg:'#fff',fs:36});
    over+=wagMeter(1,1);
  }
  return {panel,over,cam,shake};
}

// ---------- PUNCHLINE: animal hospital ----------
function vetRoom(){ let s='';
  s+=`<rect x="-900" y="-700" width="3000" height="1300" fill="#CDEBE2"/>`;
  for(let x=-900;x<2100;x+=80) s+=`<rect x="${x}" y="-700" width="40" height="1300" fill="#C2E3D9"/>`;
  s+=`<rect x="-900" y="${FLOOR}" width="3000" height="600" fill="#B9C4CC"/>`;
  for(let x=-900;x<2100;x+=90) s+=`<path d="M${x},${FLOOR} L${x-60},${FLOOR+300}" stroke="#A8B4BE" stroke-width="3"/>`;
  s+=`<g transform="translate(640,96)"><rect x="-190" y="-40" width="380" height="80" rx="14" fill="#fff" stroke="${OL}" stroke-width="4"/><text x="20" y="12" text-anchor="middle" font-size="34" font-weight="800" fill="#3E6FC0">ANIMAL HOSPITAL</text><g transform="translate(-160,0)"><rect x="-8" y="-24" width="16" height="48" fill="#E5383B"/><rect x="-24" y="-8" width="48" height="16" fill="#E5383B"/></g></g>`;
  s+=`<g transform="translate(220,170)"><rect x="-80" y="-70" width="160" height="140" fill="#1A2244" stroke="#fff" stroke-width="8"/><circle cx="30" cy="-30" r="16" fill="#FFF3C4"/><path d="M-80,0 L80,0 M0,-70 L0,70" stroke="#fff" stroke-width="6"/></g>`;
  s+=`<g transform="translate(1020,250)"><rect x="-26" y="-18" width="52" height="34" rx="8" fill="#2a2730" stroke="${OL}" stroke-width="3"/><text y="6" text-anchor="middle" font-size="16" font-weight="800" fill="#FF6B5E">03:00</text></g>`;
  // monitor
  s+=`<g transform="translate(1020,380)"><rect x="-70" y="-56" width="140" height="100" rx="10" fill="#1E1A24" stroke="${OL}" stroke-width="4"/><path d="M-60,-6 ${Array.from({length:12},(_,i)=>{const x=-60+i*10;const ph=((T*1.2*10+i)%12);return `L${x},${ph<1?-36:ph<2?20:-6}`}).join(' ')}" stroke="#59D08F" stroke-width="4" fill="none"/><rect x="-6" y="44" width="12" height="${FLOOR-380-44}" fill="#8A93A0"/></g>`;
  // pet bed (low exam table)
  s+=`<rect x="580" y="${FLOOR-110}" width="380" height="26" rx="10" fill="#E9EEF2" stroke="${OL}" stroke-width="4"/><rect x="600" y="${FLOOR-86}" width="16" height="86" fill="#8A93A0"/><rect x="924" y="${FLOOR-86}" width="16" height="86" fill="#8A93A0"/>`;
  s+=`<path d="M600,${FLOOR-110} Q770,${FLOOR-150} 940,${FLOOR-110}Z" fill="#9FC7E8" stroke="${OL}" stroke-width="3.5"/>`;
  return s; }
function receipt(x,y,len,k){ if(k<=0.01) return ''; let s=`<g transform="translate(${x},${y})">`;
  s+=`<rect x="-62" y="-30" width="124" height="40" rx="8" fill="#5A6878" stroke="${OL}" stroke-width="4"/>`;
  const L=len*k; s+=`<path d="M-48,8 L48,8 L48,${8+L} ${Array.from({length:8},(_,i)=>`L${48-i*12-6},${8+L+(i%2?0:8)}`).join(' ')} L-48,${8+L}Z" fill="#FFFDF6" stroke="${OL}" stroke-width="3.5"/>`;
  for(let yy=30;yy<L-10;yy+=22) s+=`<path d="M-36,${8+yy} L${(yy*7)%40},${8+yy} M${18},${8+yy} L36,${8+yy}" stroke="#9A928A" stroke-width="4"/>`;
  if(L>140) s+=`<text x="0" y="${L-14}" text-anchor="middle" font-size="20" font-weight="800" fill="#E5383B">TOTAL</text><text x="0" y="${L+8}" text-anchor="middle" font-size="22" font-weight="800" fill="#E5383B">$$$$$</text>`;
  return s+`</g>`; }
function punch(t){ const p0=CLIP('m2').start, b1=P_('m2.1'), b2=P_('m2.2'), b2e=PE('m2.2'); let panel='', over='';
  panel+=vetRoom();
  panel+=dog({x:800,y:FLOOR-106,flip:true,pose:'lie',eyes:t<b2?'sick':'closed',ears:0.9,headAng:22,cone:true,bandage:true,breathSpd:1.4,s:0.8});
  // hero asleep in a chair, then wakes up to the bill
  const shock=t>=b2+0.6;
  let o={x:385,y:FLOOR,face:shock?'shock':'bored',blink:shock?0:1,messy:1,tilt:shock?0:Math.sin(T*1.3)*6-3,lean:shock?0:Math.sin(T*1.3+0.5)*1.5,armL:armL(-60,-90),armR:shock?armR(36,-206,-1):armR(60,-90),lookX:shock?6:0};
  panel+=heroAt(o);
  // bill printer on the wall, paper falls to the floor
  const rk=E(t,b2+0.1,b2e-0.1);
  panel+=receipt(530,170,FLOOR-180,rk);
  // size check: turkey vs bill
  if(t>=b2+0.6){ const sk=popS(t,b2+0.6); panel+=`<g opacity="${sk}">`+turkeyBird(640,FLOOR-8,0.42,false)+`</g>`; }
  const cam={s:kval(t,[[p0,1.0],[b2,1.05],[b2e,1.1]]),x:kval(t,[[p0,640],[b2,610]]),y:kval(t,[[p0,330],[b2e,320]])}; CAM=cam;
  if(!shock) for(let i=0;i<3;i++){ const p=((T*0.6+i/3)%1); over+=`<text x="${SX(420)+p*60+i*4}" y="${SY(FLOOR-330)-p*90}" font-size="${24+p*18}" font-weight="800" fill="#fff" stroke="#2a2018" stroke-width="5" paint-order="stroke" opacity="${1-p}">Z</text>`; }
  if(t<b1) over+=badge(760,560,'1 BONE',{sc:popS(t,p0+0.05),fs:40,bg:'#fff',rot:-2});
  else if(t<b2) over+=badge(760,560,'= 1 NIGHT HERE',{sc:popS(t,b1+0.4),fs:36,bg:'#fff',rot:2});
  if(t>=b2+0.6){ const sk=popS(t,b2+0.6);
    over+=`<g opacity="${sk}"><path d="M${SX(700)},${SY(FLOOR-40)} L${SX(700)},${SY(FLOOR)}" stroke="#F6C945" stroke-width="5" stroke-dasharray="8 6"/><path d="M${SX(596)},${SY(180)} L${SX(596)},${SY(FLOOR)}" stroke="#E5383B" stroke-width="5" stroke-dasharray="10 8"/></g>`;
    over+=badge(SX(680),SY(FLOOR-70),'TURKEY',{sc:sk,fs:24,bg:'#F6C945'}); over+=badge(SX(600)+70,SY(300),'BILL',{sc:sk,fs:34,bg:'#E5383B',fg:'#fff',rot:-4}); }
  return {panel,over,cam}; }

// ---------- TIP ----------
function tipIcon(kind){ let s='';
  if(kind==='bone') s=boneProp(0,0,-30,0.8,false)+`<path d="M-30,-30 L30,30 M30,-30 L-30,30" stroke="#FF6B5E" stroke-width="6" stroke-linecap="round"/>`;
  if(kind==='gravy') s=gravyBoat(0,8,0.9)+`<path d="M-30,-30 L30,30 M30,-30 L-30,30" stroke="#FF6B5E" stroke-width="6" stroke-linecap="round"/>`;
  if(kind==='bin') s=`<g transform="scale(.42) translate(0,60)">${bin(0,0,{lid:0})}</g>`;
  if(kind==='vet') s=`<circle r="30" fill="none" stroke="#fff" stroke-width="5"/><path d="M-6,-18 L6,-18 L6,-6 L18,-6 L18,6 L6,6 L6,18 L-6,18 L-6,6 L-18,6 L-18,-6 L-6,-6Z" fill="#fff"/>`;
  return s; }
function tip(t){ let over='';
  const q=P_('m3.0'), sk=P_('m3.1'), cl=P_('m3.2'), as=P_('m3.3'), cv=P_('m3.4');
  over+=badge(690,64,'DOGS + HOLIDAY FOOD',{sc:popS(t,CLIP('m3').start),fs:30,bg:'#fff'});
  const tile=(x,y,ts,ic,lines,bgc,hl)=>{ if(t<ts) return ''; const k=popS(t,ts)*(hl?1.06+0.025*Math.sin(T*6):1); const fs=lines.length>2?22:25; const y0=lines.length==1?10:lines.length==2?-8:-22;
    return `<g transform="translate(${x},${y}) scale(${k})"><rect x="-176" y="-80" width="352" height="160" rx="20" fill="${bgc}" stroke="${hl?'#F6C945':'#fff'}" stroke-width="${hl?8:5}"/><g transform="translate(-116,0) scale(1.15)">${tipIcon(ic)}</g>${lines.map((l,i)=>`<text x="50" y="${y0+i*(fs+8)}" text-anchor="middle" font-size="${fs}" font-weight="800" fill="#fff">${l}</text>`).join('')}</g>`; };
  over+=tile(500,200,q,'bone',['NO TURKEY','BONES'],'#E5383B',t>=q&&t<sk);
  over+=tile(870,200,sk,'gravy',['NO SKIN,','FAT OR GRAVY'],'#D9682F',t>=sk&&t<cl);
  over+=tile(500,380,cl,'bin',['CLOSE THE','TRASH BAG'],'#5B5F8C',t>=cl&&t<as);
  over+=tile(870,380,as,'vet',['ACTS STRANGE?','CALL A VET'],'#3FB27F',t>=as);
  if(t>=cv) over+=badge(686,548,'RIGHT AWAY',{sc:popS(t,cv),fs:30,bg:'#fff',rot:-2});
  return over; }

function scene(t){
  let panel='', cam={s:1,x:540,y:304}, gray=false, over='', fine=null, shake=0, rot=0;
  const M1=CLIP('m1'), N4=CLIP('n4'), M2=CLIP('m2'), M3=CLIP('m3'), M4=CLIP('m4');
  const pauseAt=M1.start-0.15, rwEnd=N4.start-0.05, rwStart=rwEnd-1.0;
  const fz=FZ();
  if(t<pauseAt){ const tt=Math.min(t,fz); const keep=T; if(t>fz) T=fz; const b=badPath(tt); T=keep; panel=b.panel; over=b.over; cam=b.cam; shake=t<fz?b.shake:0;
    if(t>=fz) over+=`<rect width="1080" height="608" fill="#fff" opacity="${0.5*(1-A(t,fz,fz+0.25))}"/>`; }
  else if(t<rwStart){
    gray=true; const keep=T; T=fz; const b=badPath(fz); T=keep; panel=b.panel; cam=b.cam;
    over+=`<g opacity="${A(t,pauseAt,pauseAt+0.2)}"><rect x="34" y="34" width="14" height="46" fill="#141218"/><rect x="58" y="34" width="14" height="46" fill="#141218"/><text x="88" y="70" font-size="30" font-weight="800" fill="#141218" stroke="#fff" stroke-width="5" paint-order="stroke">PAUSED</text></g>`;
    const v=P_('m1.1'), st=P_('m1.2'), rw=P_('m1.3');
    if(t>=v-0.45) over+=`<rect x="330" y="0" width="750" height="608" fill="#141218" opacity="${0.9*A(t,v-0.45,v-0.05)}"/>`;
    over+=pauseDiagram(t);
    const wi=A(t,pauseAt,pauseAt+0.9), fx=mix(-120,150,wi);
    let o={x:fx,y:575,s:0.86,mouth:fineMouth(),walk:t<pauseAt+0.9?(t*2)%1:null,armL:[-8,2],armR:[40,60],handR:'remote',remoteAng:70,
      emo:t<v?'neutral':t<st?'serious':t<rw?'worried':'neutral'};
    if(t<pauseAt+1.1&&t>=pauseAt+0.9){o.armR=[70,50];o.press=true}
    if(t>=rw){o.armR=[70,50];o.press=t>rw+0.1&&t<rw+0.5}
    fine=o;
  }
  else if(t<rwEnd){
    const k=L(t,rwStart,rwEnd); const back=mix(fz,0.4,Math.pow(k,0.8));
    const keep=T; T=back; const b=badPath(back); T=keep;
    panel=b.panel; cam=b.cam; gray=k<0.4;
    over+=`<g><path d="M40,40 L60,58 L40,76Z M64,40 L84,58 L64,76Z" fill="#fff" stroke="#141218" stroke-width="3" transform="rotate(180,62,58)"/><text x="100" y="70" font-size="30" font-weight="800" fill="#fff" stroke="#141218" stroke-width="5" paint-order="stroke">REWIND</text></g>`;
    for(let i=0;i<5;i++){const yy=(i*137+t*900)%608;over+=`<rect x="0" y="${yy}" width="1080" height="${6+i%3*4}" fill="#fff" opacity=".25"/>`}
    fine={x:150,y:575,s:0.86,armR:[70,50],handR:'remote',remoteAng:70,press:true,mouth:0,emo:'neutral'};
  }
  else if(t<M2.start){ const r=rightMove(t); panel=r.panel; over=r.over; cam=r.cam; shake=r.shake;
    const a1=P_('n4.1'), hS=CLIP('h2').start, h21=P_('h2.1');
    fine={x:150,y:575,s:0.86,mouth:fineMouth(),emo:t<a1?'serious':'neutral'};
    if(t>=h21){ fine.mouth=0; fine.emo='happy'; fine.armR=[30,150]; fine.handR='thumb'; }
  }
  else if(t<M3.start){ const r=punch(t); panel=r.panel; over=r.over; cam=r.cam;
    const b2=P_('m2.2');
    let f={x:150,y:575,s:0.86,mouth:fineMouth(),emo:t<P_('m2.1')?'neutral':t<b2?'serious':'happy'};
    f.wink=t>PE('m2.2')-0.4&&t<PE('m2.2')+0.3;
    fine=f;
  }
  else if(t<M4.start){
    panel+=room({late:0})+table({late:0,missing:true});
    panel+=`<rect x="-3200" y="-1600" width="9200" height="4000" fill="#1b1622" opacity=".88"/>`;
    over+=tip(t);
    let o={x:150,y:575,s:0.95,mouth:fineMouth(),emo:'serious'};
    if(t>=P_('m3.0')+0.3&&t<M4.start-0.3){o.armR=[120,-10];o.handR='point'}
    fine=o; cam={s:0.9,x:mix(560,660,L(t,M3.start,M4.start)),y:400};
  }
  else {
    const e0=M4.start-0.2;
    panel+=`<rect x="0" y="0" width="1080" height="608" fill="url(#cardbg)"/>`;
    panel+=`<g opacity="${A(t,e0,e0+0.3)}"><text x="740" y="230" text-anchor="middle" font-size="98" font-weight="800" fill="#1C1A20" letter-spacing="-2">MR FINE</text>
      <text x="740" y="305" text-anchor="middle" font-size="42" font-weight="700" fill="#1f1b24" opacity="${A(t,e0+0.3,e0+0.6)}">The bone can wait.</text>
      <g transform="translate(752,390) scale(${popS(t,P_('m4.1'))})"><text x="0" y="0" text-anchor="middle" font-size="44" font-weight="800" fill="#E86A90">YOUR DOG'S LIFE CAN'T.</text></g></g>`;
    const m=fineMouth();
    fine={x:300,y:548,s:1.4,mouth:m,armR:t<P_('m4.1')?[150+Math.sin(t*14)*12,10]:[30,150],handR:t<P_('m4.1')?'':'thumb',wink:t>M4.start+M4.dur+0.4,emo:'neutral',smile:t>M4.start+M4.dur+0.3};
    cam={s:1.0,x:540,y:304};
    return {panel,cam,gray,over:mrFine(fine)+over,raw:true,shake,rot};
  }
  over=(fine?mrFine(fine):'')+over;
  return {panel,cam,gray,over,shake,rot};
}
const DEFS2=`<defs><linearGradient id="eveSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3B3A7A"/><stop offset=".55" stop-color="#C8607A"/><stop offset="1" stop-color="#F2A65A"/></linearGradient>
<radialGradient id="candleGlow"><stop offset="0" stop-color="#FFD98A" stop-opacity=".7"/><stop offset="1" stop-color="#FFD98A" stop-opacity="0"/></radialGradient>
<radialGradient id="lampWarm"><stop offset="0" stop-color="#FFE2A0" stop-opacity=".32"/><stop offset="1" stop-color="#FFE2A0" stop-opacity="0"/></radialGradient></defs>`;

function render(t){
  TREAL=t; T=t;
  const sc=scene(T);
  const c=sc.cam; const sh=sc.shake||0; const tr=`translate(${540+Math.sin(t*60)*sh},${304+Math.cos(t*53)*sh}) scale(${c.s}) rotate(${sc.rot||0}) translate(${-c.x},${-c.y})`;
  let base=g(tr,sc.panel);
  if(sc.gray) base=`<g filter="url(#gray)">${base}</g><rect width="1080" height="608" fill="url(#scan)"/>`;
  let panelInner=base+sc.over;
  const tilt=sc.gray? -0.6:0;
  let s=DEFS+DEFS2;
  s+=`<rect width="1080" height="1920" fill="#08070a"/>`;
  s+=`<g transform="translate(0,652) rotate(${tilt},540,304)"><g clip-path="url(#pc)">${panelInner}</g></g>`;
  s+=`<rect x="160" y="474" width="760" height="172" rx="12" fill="#DC273B"/>
      <text x="540" y="548" text-anchor="middle" font-size="52" font-weight="800" fill="#fff" letter-spacing="-1">WHAT IF YOU GIVE YOUR</text>
      <text x="540" y="618" text-anchor="middle" font-size="52" font-weight="800" fill="#fff" letter-spacing="-1">DOG A TURKEY BONE?</text>`;
  s+=captions(t);
  document.getElementById('v').innerHTML=s;
}
window.render=render;
</script></body></html>
